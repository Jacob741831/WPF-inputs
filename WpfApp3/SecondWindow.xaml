<Window x:Class="WpfApp1.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta - dane"
        Height="400" Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>

            <TextBlock Text="Uzupełnij ankietę"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Wiek:" Margin="0,0,0,5"/>

            <TextBox x:Name="WiekBox"
                     Height="30"
                     Padding="5"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Ulubiony kolor:"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="KolorBox"
                      Height="30"
                      SelectedIndex="0"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Czerwony"/>
                <ComboBoxItem Content="Niebieski"/>
                <ComboBoxItem Content="Zielony"/>
                <ComboBoxItem Content="Żółty"/>
                <ComboBoxItem Content="Czarny"/>
                <ComboBoxItem Content="Biały"/>
            </ComboBox>

            <CheckBox x:Name="ZgodaCheck"
                      Content="Wyrażam zgodę"
                      Margin="0,0,0,25"/>

            <Button Content="Zapisz i pokaż wyniki"
                    Height="40"
                    Background="#FF007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Zapisz_Click"/>

        </StackPanel>
    </Grid>
</Window>