<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ankieta - płeć"
        Height="300" Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Wybierz płeć"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <RadioButton x:Name="RadioM"
                         Content="M"
                         GroupName="Plec"
                         Margin="10"
                         IsChecked="True"/>

            <RadioButton x:Name="RadioK"
                         Content="K"
                         GroupName="Plec"
                         Margin="10"/>

            <RadioButton x:Name="RadioI"
                         Content="I"
                         GroupName="Plec"
                         Margin="10,10,10,25"/>

            <Button Content="Dalej"
                    Height="40"
                    Background="#FF007ACC"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="Dalej_Click"/>

        </StackPanel>
    </Grid>
</Window>